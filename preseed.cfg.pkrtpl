# ── Langue / Clavier ──
d-i debian-installer/locale string fr_FR.UTF-8
d-i keyboard-configuration/xkb-keymap select fr

# ── Réseau (DHCP auto) ──
d-i netcfg/choose_interface select auto
d-i netcfg/get_hostname string ${vm_hostname}
d-i netcfg/get_domain string

# ── Miroir Debian ──
d-i mirror/country string manual
d-i mirror/http/hostname string deb.debian.org
d-i mirror/http/directory string /debian
d-i mirror/http/proxy string

# ── Compte root désactivé, user créé ──
d-i passwd/root-login boolean false
d-i passwd/user-fullname string ${username}
d-i passwd/username string ${username}
d-i passwd/user-password password ${password}
d-i passwd/user-password-again password ${password}

# ── Partitionnement (une seule partition root, pas de swap) ──
d-i partman-auto/method string regular
d-i partman-auto/expert_recipe string \
    single-root :: \
        1000 10000 -1 ext4 \
            $primary{ } $bootable{ } \
            method{ format } format{ } \
            use_filesystem{ } filesystem{ ext4 } \
            mountpoint{ / } \
        .
d-i partman-auto/choose_recipe select single-root
d-i partman-basicfilesystems/no_swap boolean false
d-i partman/confirm_write_new_label boolean true
d-i partman/choose_partition select finish
d-i partman/confirm boolean true
d-i partman/confirm_nooverwrite boolean true

# ── Fuseau horaire ──
d-i clock-setup/utc boolean true
d-i time/zone string Europe/Paris

# ── Firmware non-free (nouveau Debian 12+) ──
d-i apt-setup/non-free-firmware boolean true
d-i apt-setup/non-free boolean true
d-i apt-setup/contrib boolean true

# ── Popularity contest ──
popularity-contest popularity-contest/participate boolean false

# ── Gestion des paquets (pas de CD supplémentaire, miroir réseau oui) ──
d-i apt-setup/cdrom/set-first boolean false

# ── Paquets de base ──
tasksel tasksel/first multiselect standard, ssh-server
d-i pkgsel/include string ${packages}
d-i pkgsel/upgrade select full-upgrade

# ── GRUB ──
d-i grub-installer/only_debian boolean true
d-i grub-installer/bootdev string default

# ── Redémarrage auto à la fin ──
d-i finish-install/reboot_in_progress note

# ── Commande post-install : sudo sans password pour (nécessaire pour Packer) ──
d-i preseed/late_command string \
    in-target sh -c 'echo "${username} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${username} && chmod 440 /etc/sudoers.d/${username} && echo "network: {config: disabled}" > /etc/cloud/cloud.cfg.d/99-packer-build.cfg'
