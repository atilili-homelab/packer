use flake

# BAO_ADDR pour le client bao, VAULT_ADDR pour la fonction vault() de Packer
export BAO_ADDR='http://sati.macopla.home:8200'
export VAULT_ADDR="$BAO_ADDR"

# Connexion AppRole : en cas d'échec, on prévient sans bloquer,
# pour que les outils et BAO_ADDR restent disponibles
packer_vault_login() {
    if ! rbw unlocked >/dev/null 2>&1; then
        log_error "rbw verrouillé — lance 'rbw unlock' puis 'direnv reload'"
        return 1
    fi
    local role_id
    # En cas d'échec, role_id contient le message d'erreur de rbw (2>&1)
    if ! role_id="$(rbw get 'Openbao Packer Role_id' 2>&1)"; then
        log_error "lecture rbw 'Openbao Packer Role_id' impossible : $role_id"
        return 1
    fi
    # secret_id passé par stdin, jamais en argument (visible dans la liste des processus)
    VAULT_TOKEN="$(rbw get 'Openbao Packer Secret_id' |
        bao write -field=token auth/approle/login role_id="$role_id" secret_id=-)" || {
        log_error "connexion AppRole OpenBao échouée"
        return 1
    }
    export VAULT_TOKEN
}

packer_vault_login || log_error "VAULT_TOKEN non défini : packer build ne pourra pas lire ses secrets"

# IP du poste vue depuis Proxmox : celle de l'interface qui route vers l'API.
# La VM en cours d'installation télécharge le preseed sur cette IP.
proxmox_host="$(sed -nE 's|^proxmox_url *= *"https?://([^:/"]+).*|\1|p' debian-13.auto.pkrvars.hcl)"
PKR_VAR_packer_ip="$(ip -4 route get "$proxmox_host" 2>/dev/null |
    awk '{for (i = 1; i < NF; i++) if ($i == "src") print $(i + 1)}')"
if [ -n "$PKR_VAR_packer_ip" ]; then
    export PKR_VAR_packer_ip
else
    log_error "IP vers Proxmox ($proxmox_host) introuvable : packer_ip restera en détection automatique"
fi
